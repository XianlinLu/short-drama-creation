{
  "name": "short-drama-creation",
  "version": "2.2.0",
  "mode": "lumina-canvas",
  "language": "auto",
  "language_policy": {
    "interaction": "latest_direct_user_request",
    "story": "explicit_then_draft_then_interaction",
    "visible_process": "interaction_language",
    "ignore_for_detection": [
      "quoted_content",
      "attachments",
      "retrieved_sources",
      "pasted_drafts",
      "code",
      "metadata",
      "tool_output"
    ]
  },
  "entry": "SKILL.md",
  "runtime_entry": "LUMINA_SYSTEM_INSTRUCTIONS.md",
  "interface": "agents/interface.yaml",
  "resources": [
    "LUMINA_SYSTEM_INSTRUCTIONS.md",
    "references/technique-matrix.md",
    "references/inspiration-remix-playbook.md",
    "references/source-research-remix.md",
    "references/story-engine-library.md",
    "references/prewrite-interview.md",
    "references/output-contract.md",
    "references/anti-ai-language.md",
    "references/language-routing.md",
    "references/topic-direction-ui.md",
    "references/character-video-demo.md",
    "references/quality-checklist.md",
    "references/genre-quality-rubric.md",
    "references/evolution-loop.md",
    "references/repository-validation.md",
    "examples/sample-01-wuxia-suspense.md",
    "examples/sample-02-sci-fi-memory.md"
  ],
  "quality_gates": [
    "intent_hook_selected",
    "interaction_language_detected_from_latest_direct_request",
    "quoted_and_attached_content_ignored_for_language_detection",
    "visible_process_language_consistent",
    "story_language_selected_separately",
    "fixed_templates_localized",
    "all_modes_use_native_topic_direction_ui",
    "topic_direction_ui_has_one_question_and_four_options",
    "topic_direction_ui_has_recommended_first_and_native_other",
    "topic_direction_ui_stops_the_current_run",
    "topic_direction_ui_has_no_text_or_numbered_fallback",
    "missing_topic_ui_capability_stops_generation",
    "source_research_when_requested_and_connected",
    "research_signals_translated_to_functions",
    "inspiration_directions_shown_through_native_ui",
    "classic_beats_translated_not_copied",
    "emotion_payoff_selected",
    "story_engine_library_selected",
    "genre_rubric_loaded",
    "prewrite_interview_when_vague",
    "story_strategy_outline_confirmed",
    "prewrite_stop_point_respected",
    "original_complete_short_story",
    "technique_translation_not_author_imitation",
    "strong_opening_hook",
    "clear_protagonist_desire",
    "escalating_conflict",
    "dialogue_tension",
    "image_driven_scene",
    "reversal_or_suspense",
    "ending_aftertaste",
    "opening_semantic_clarity_gate",
    "anti_ai_language_gate",
    "living_author_style_translated_to_craft",
    "copyright_boundary",
    "lumina_connected_tool_boundary_respected",
    "feedback_classified_before_rewrite",
    "stable_rule_promotion_avoids_overfitting",
    "character_video_mode_requires_three_view_and_visual_intent",
    "four_topic_directions_shown_in_native_ui_before_media_generation",
    "topic_choice_stop_point_respected",
    "topic_choice_uses_one_native_single_select_question",
    "topic_ui_uses_localized_header_labels_and_descriptions",
    "topic_ui_includes_recommended_and_custom_paths",
    "original_micro_story_created_after_selection",
    "explicit_target_duration_locked_before_generation",
    "connected_duration_limits_inspected",
    "target_duration_is_reachable_before_media_generation",
    "one_seed_storyboard_generated",
    "one_short_seed_video_generated",
    "each_extension_uses_previous_complete_video",
    "extensions_run_sequentially",
    "each_video_prompt_uses_an_independent_local_timeline",
    "each_video_prompt_starts_at_zero",
    "prompt_local_end_matches_current_call_duration",
    "global_timecodes_stay_out_of_video_action_prompts",
    "tail_only_outputs_are_not_treated_as_extensions",
    "independent_clips_are_not_concatenated",
    "no_loop_speed_change_padding_or_silent_rounding",
    "final_duration_matches_user_target_within_declared_tolerance",
    "character_and_story_continuity_checked_across_extensions",
    "seed_and_extension_outputs_are_actual_tool_results",
    "original_instrumental_background_music_generated_by_default",
    "music_duration_matches_final_timeline",
    "music_energy_curve_matches_story_beats",
    "embedded_audio_uses_non_concatenating_route_only",
    "separate_music_is_labeled_when_embedding_is_unavailable",
    "tts_risk_rejection_identifies_exact_failed_chunk",
    "tts_recovery_rewrites_only_rejected_spoken_text",
    "successful_tts_chunks_and_upstream_media_are_preserved",
    "only_failed_tts_step_is_retried",
    "alternate_tts_voice_is_used_only_after_neutral_text_rejection",
    "downstream_video_waits_for_successful_tts",
